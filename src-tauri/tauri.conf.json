{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF-Parser",
  "version": "0.1.0",
  "identifier": "com.pdfparser.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF-Parser",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self' ipc: https://ipc.localhost asset: https://asset.localhost; worker-src 'self' blob:; object-src 'self' asset: https://asset.localhost; frame-src 'self' asset: https://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/tesseract/tesseract"],
    "resources": [
      "binaries/tesseract/*.dll",
      "binaries/tesseract/tessdata/eng.traineddata",
      "binaries/pdfium/pdfium.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "wix": {
        "language": ["en-US"]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3MDBENDVDNEVCQUQxREEKUldUYTBicE9YTlFBSjdmd3Q2WmZHc2YwVTdUMHR1NzFUZTJEYXB4czdmNFNnVGZ6a1Nidm5vaDcK",
      "endpoints": [
        "https://github.com/<OWNER>/PDF-Parser/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
